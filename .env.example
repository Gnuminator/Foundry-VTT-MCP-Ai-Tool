# Foundry AI Tool: environment variables
#
# Copy this file to `.env` (gitignored) to override a default. The bridge (mcp-server) and the
# dashboard both load `.env` from their working directory. Every value below is optional and shows
# its default. Nothing here is a secret; keep real tokens and keys only in your local `.env`.
# Environment variables set in Claude Desktop's config ("env" block) win over `.env`.

# =============================================================================
# Bridge (packages/mcp-server)
# =============================================================================

# Control channel the dashboard and the standalone bridge talk over. Keep it on loopback.
# MCP_CONTROL_HOST=127.0.0.1
# MCP_CONTROL_PORT=31414

# Foundry link the module dials: WebSocket on FOUNDRY_PORT, WebRTC signalling on FOUNDRY_WEBRTC_PORT.
# FOUNDRY_HOST=localhost
# FOUNDRY_PORT=31415
# FOUNDRY_NAMESPACE=/foundry-mcp
# FOUNDRY_CONNECTION_TYPE=auto          # auto | websocket | webrtc
# FOUNDRY_PROTOCOL=ws                   # ws | wss (WebSocket mode only)
# FOUNDRY_REMOTE_MODE=false
# FOUNDRY_REJECT_UNAUTHORIZED=true      # set false only for a self-signed certificate you trust
# FOUNDRY_CONNECTION_TIMEOUT=10000      # ms
# FOUNDRY_RECONNECT_ATTEMPTS=5
# FOUNDRY_RECONNECT_DELAY=1000          # ms
# FOUNDRY_STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# FOUNDRY_WEBRTC_PORT=31416
# FOUNDRY_LINK_HOST=127.0.0.1          # bind address of the Foundry link; anything that reaches it can drive Foundry

# off | false | 0 | no: serve the control channel only, never bind the Foundry link (used for
# smoke tests on alternate ports, see docs/dev/SMOKE-TEST.md).
# MCP_FOUNDRY_LINK=on

# Largest tool response sent back to the AI client, in characters.
# TOOL_RESPONSE_MAX_CHARS=20000

# Reported MCP server identity.
# SERVER_NAME=foundry-mcp-server
# SERVER_VERSION=                       # defaults to the built-in version

# Logging
# LOG_LEVEL=warn                        # error | warn | info | debug
# LOG_FORMAT=simple                     # simple | json
# ENABLE_FILE_LOGGING=false
# LOG_FILE_PATH=./logs/mcp-server.log

# =============================================================================
# Bridge vault, play log and Obsidian export
# =============================================================================

# Where the bridge vault lives. Default: %APPDATA%\foundry-ai-tool\vault on Windows,
# $XDG_DATA_HOME or ~/.local/share/foundry-ai-tool/vault elsewhere.
# FOUNDRY_AI_DATA_DIR=

# Play recorder and event pump (off | false | 0 | no turns them off).
# FOUNDRY_AI_PLAY_LOG=on
# FOUNDRY_AI_EVENT_LOG=on
# FOUNDRY_AI_EVENT_POLL_MS=

# Obsidian vault folder the renderer writes to (turns the export on), how often Foundry mirror
# notes are polled, and the base URL used for "open in Foundry" links.
# FOUNDRY_AI_OBSIDIAN_DIR=
# FOUNDRY_AI_MIRROR_POLL_MS=
# FOUNDRY_AI_OPEN_BASE=

# =============================================================================
# Dashboard (packages/cogm-dashboard)
# =============================================================================

# Where the dashboard listens. Loopback unless you set it; a non-loopback bind needs
# GM_DASHBOARD_TOKEN. Put a tunnel's or proxy's public name in DASHBOARD_ALLOWED_HOSTS.
# PORT=3000
# DASHBOARD_HOST=127.0.0.1
# DASHBOARD_ALLOWED_HOSTS=

# Login. GM_DASHBOARD_TOKEN or GM_EMAILS (Cloudflare Access) turns on the GM / player split.
# Leave both empty for a single-user, loopback-only dashboard.
# GM_DASHBOARD_TOKEN=
# PLAYER_DASHBOARD_TOKEN=
# GM_EMAILS=
# Cloudflare Access login check (I-022): the team domain and the Access application's AUD tag.
# Both needed for GM_EMAILS to work; the email comes only from Access's signed token.
# CF_ACCESS_TEAM_DOMAIN=<team>.cloudflareaccess.com
# CF_ACCESS_AUD=<the application's AUD tag>

# Player page: what players may see on enemies.
# PLAYER_SHOW_ENEMY_CONDITIONS=true
# PLAYER_SHOW_ENEMY_HP_BANDS=false

# "Open in Obsidian" links: vault name (falls back to the folder name of FOUNDRY_AI_OBSIDIAN_DIR).
# OBSIDIAN_VAULT_NAME=

# Polling and control-channel timing (ms).
# POLL_INTERVAL_MS=4000
# COMBAT_POLL_INTERVAL_MS=4000
# ERROR_POLL_INTERVAL_MS=6000
# MCP_REQUEST_TIMEOUT_MS=15000
# MCP_CONNECT_TIMEOUT_MS=5000
# MCP_HEARTBEAT_INTERVAL_MS=10000
# MCP_STALENESS_THRESHOLD_MS=30000

# Optional paid co-GM commentary. Off unless a key is set (subscription-first: D-066). Put the real
# key only in your local `.env`, never in this file.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# COGM_TONE=tactical                    # tactical | narrative
# COMMENT_MIN_INTERVAL_MS=20000
# COMMENT_DEBOUNCE_MS=1500
# COGM_MAX_EVENTS=80
# COGM_COMMENT_MAX_TOKENS=320
# COGM_ASK_MAX_TOKENS=700
# COGM_MAX_ERRORS=100
# COGM_COMMENT_ON_ERRORS=true
# ERROR_COMMENT_MIN_INTERVAL_MS=60000
# COGM_ERROR_COMMENT_MAX_TOKENS=280

# =============================================================================
# Scripts
# =============================================================================

# Dashboard base URL for scripts/live-read-sweep.mjs.
# COGM_BASE=http://localhost:3100

{
  "name": "foundry-ai-tool",
  "version": "0.20.0",
  "description": "Foundry AI Tool — MCP server + Foundry module + co-GM dashboard for AI-powered Foundry VTT integration",
  "private": true,
  "workspaces": [
    "packages/*",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=packages/mcp-server",
    "build": "npm run build:shared && npm run build --workspaces --if-present",
    "build:foundry": "npm run build --workspace=packages/foundry-module",
    "build:server": "npm run build --workspace=packages/mcp-server",
    "build:shared": "npm run build --workspace=shared",
    "dev:cogm": "npm run dev --workspace=packages/cogm-dashboard",
    "build:cogm": "npm run build --workspace=packages/cogm-dashboard",
    "start:cogm": "npm run start --workspace=packages/cogm-dashboard",
    "bridge:standalone": "npm run start:standalone --workspace=packages/mcp-server",
    "test:standalone": "node scripts/standalone-smoke-test.mjs",
    "bundle:server": "npm run build:bundle --workspace=packages/mcp-server",
    "build:release": "npm run build:shared && npm run build:server && npm run bundle:server && npm run build:foundry",
    "installer:stage": "node installer/build-nsis.js --skip-download --skip-nsis",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint . --ext .ts,.js",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "lint:ratchet": "node scripts/lint-ratchet.mjs",
    "emdash:ratchet": "node scripts/em-dash-guard.mjs",
    "validate:manifest": "node scripts/validate-manifest.js",
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check",
    "docs:lint": "markdownlint-cli2",
    "docs:links": "node scripts/check-links.mjs",
    "docs:tools": "node scripts/docs-tools.mjs",
    "usage:catalog": "node scripts/usage-catalog.mjs",
    "usage:catalog:check": "node scripts/usage-catalog.mjs --check",
    "live:roundtrip": "node scripts/live-roundtrip.mjs",
    "live:sweep": "node scripts/live-write-sweep.mjs",
    "demo:obs-setup": "node scripts/demo/demo.mjs obs-setup",
    "demo:take": "node scripts/demo/demo.mjs take",
    "demo:export": "node scripts/demo/export.mjs",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "typecheck": "npm run build:shared && npm run typecheck --workspaces --if-present",
    "vault": "node packages/mcp-server/dist/vault-cli.js",
    "obsidian": "node packages/mcp-server/dist/obsidian-cli.js",
    "test:mcp:schema": "node scripts/mcp-schema-smoke-test.mjs",
    "audit:deps": "npm audit && npm run audit --workspaces --if-present",
    "audit:unused": "npx knip",
    "audit:circular": "npx madge --circular --extensions ts packages/mcp-server/src packages/foundry-module/src shared/src",
    "size:analyze": "npm run bundle:server && npx esbuild-analyzer packages/mcp-server/dist/backend.bundle.cjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "esbuild-analyzer": "^0.2.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^9.1.7",
    "knip": "^5.64.1",
    "lint-staged": "^16.4.0",
    "madge": "^8.0.0",
    "markdownlint-cli2": "^0.23.3",
    "playwright-core": "^1.63.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "author": "Gnuminator <gnuminator@users.noreply.github.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gnuminator/Foundry-VTT-MCP-Ai-Tool.git"
  },
  "keywords": [
    "foundry-vtt",
    "mcp",
    "claude",
    "ai",
    "tabletop",
    "rpg"
  ],
  "lint-staged": {
    "*.{ts,js,json,md}": [
      "prettier --write"
    ]
  }
}

# ---------------------------------------------------------------------------
# Co-GM dashboard configuration. Copy to ".env" and fill in.
# No secrets are committed — .env is gitignored.
# ---------------------------------------------------------------------------

# How often to poll the MCP bridge for new events, in milliseconds.
POLL_INTERVAL_MS=4000

# How often to poll combat state, in milliseconds (defaults to POLL_INTERVAL_MS).
# COMBAT_POLL_INTERVAL_MS=4000

# MCP backend control channel (the running bridge). Defaults shown.
MCP_CONTROL_HOST=127.0.0.1
MCP_CONTROL_PORT=31414

# HTTP port for the dashboard + its SSE stream.
PORT=3000

# Listen address. Loopback by default (reach it through a tunnel such as cloudflared).
# Any other address (e.g. 0.0.0.0 in Docker) is refused unless GM_DASHBOARD_TOKEN is set
# and at least 32 characters long.
# DASHBOARD_HOST=127.0.0.1

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info

# --- Module diagnostics (live error feed) ----------------------------------
# How often to poll Foundry module errors/warnings, in milliseconds.
# ERROR_POLL_INTERVAL_MS=6000
# Rolling window size for the in-memory module-error buffer.
# COGM_MAX_ERRORS=100

# --- Control-channel tuning (advanced) -------------------------------------
# Per-request reply timeout; a timeout forces a reconnect.
# MCP_REQUEST_TIMEOUT_MS=15000
# TCP connect timeout.
# MCP_CONNECT_TIMEOUT_MS=5000
# Heartbeat ping cadence (detects a hung / half-open backend).
# MCP_HEARTBEAT_INTERVAL_MS=10000
# Window after the last reply before the channel is treated as stale.
# MCP_STALENESS_THRESHOLD_MS=30000

# --- Player / GM split + auth (Phase 6) ------------------------------------
# The split is OPT-IN. With NONE of GM_DASHBOARD_TOKEN / GM_EMAILS set, the
# dashboard runs in single-user GM mode (no token needed) — the default/legacy
# localhost behavior. Setting either one turns the split ON: callers must prove
# GM identity to reach the GM surface; everyone else gets the read-only /player
# view (combat order + public feed only — no enemy HP, diagnostics, or controls).
#
# Shared GM secret. Open the GM dashboard once as  http://host:3000/?token=THIS
# (it is then remembered in that browser). Sent as the X-CoGM-Token header / a
# ?token= query param / a cogm_token cookie.
# GM_DASHBOARD_TOKEN=
#
# Optional second factor for the player view. If unset, /player is open to any
# non-GM the outer gate (e.g. Cloudflare Access) admits.
# PLAYER_DASHBOARD_TOKEN=
#
# Cloudflare Access email allow-list mapped to the GM role (comma-separated).
# When the dashboard is behind Cloudflare Access, the email of Access's signed
# login token (checked with the two settings below) decides: a match here = GM,
# anyone else = player. The plain email header is never trusted.
# GM_EMAILS=
# Cloudflare Access login check (I-022): the team domain and the Access application's AUD tag.
# Both needed for GM_EMAILS to work; the email comes only from Access's signed token.
# CF_ACCESS_TEAM_DOMAIN=<team>.cloudflareaccess.com
# CF_ACCESS_AUD=<the application's AUD tag>
#
# What the player view may show of enemy/NPC combatants. Exact HP is NEVER shown.
# Show publicly-visible status conditions on enemies (prone, frightened, …).
# PLAYER_SHOW_ENEMY_CONDITIONS=true
# Show a COARSE HP band on enemies (healthy/bloodied/critical/down) — no numbers.
# PLAYER_SHOW_ENEMY_HP_BANDS=false
#
# Open in Obsidian links (GM only): the vault name as Obsidian shows it. Default:
# the folder name of FOUNDRY_AI_OBSIDIAN_DIR; neither set = no links.
# OBSIDIAN_VAULT_NAME=
#
# Folder for the dashboard's own small state files (the theme chosen per world).
# COGM_STATE_DIR=~/.foundry-ai-tool

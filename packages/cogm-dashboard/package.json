{
  "name": "@gnuminator/cogm-dashboard",
  "version": "0.21.0",
  "author": "Gnuminator <gnuminator@users.noreply.github.com>",
  "description": "Standalone live AI \"Co-GM\" dashboard that pulls the Foundry VTT MCP bridge feed and streams Claude commentary to a browser.",
  "type": "module",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "node scripts/build-help.mjs --soft && tsx watch src/server.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "tsc && node scripts/build-help.mjs && vite build --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:e2e": "playwright test -c web",
    "test:visual": "node scripts/visual-docker.mjs",
    "test:visual:update": "node scripts/visual-docker.mjs --update",
    "test:visual:ci": "playwright test -c web/playwright.visual.config.ts",
    "bundle:budget": "node scripts/bundle-budget.mjs",
    "typecheck": "tsc --noEmit && tsc -p web --noEmit",
    "lint": "eslint src web",
    "lint:fix": "eslint src web --fix"
  },
  "dependencies": {
    "@anthropic-ai/sdk": ">=0.40.0",
    "@gnuminator/shared": "*",
    "dotenv": "^16.3.0",
    "express": "^4.19.0",
    "htmlparser2": "^10.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "~1.64.0",
    "@tanstack/react-query": "^5.104.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "marked": "^15.0.12",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.7.0",
    "typescript": "^5.0.0",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "foundry-vtt",
    "mcp",
    "claude",
    "ai",
    "dashboard",
    "co-gm"
  ],
  "license": "MIT"
}

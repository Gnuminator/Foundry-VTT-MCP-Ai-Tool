# The recorder bot's settings on the Orange Pi: /etc/foundry-ai-tool/discord-bot.env
# (owner root, group foundry, mode 0640; the folder is 0750). The service reads it through
# systemd's EnvironmentFile. The user pastes the token; Claude never types or prints it.

# The bot token from the Discord developer page (Bot > Reset Token). Required.
DISCORD_TOKEN=

# The Discord server (guild) id: the slash commands /record start and /record stop appear there
# at once. Optional; without it they register globally, which can take up to an hour.
DISCORD_GUILD_ID=

# Who gets the storage space DMs (your Discord user id). Optional: without it the bot DMs the owner of
# the bot application in the Discord Developer Portal. If neither is found, the DMs are off (logged
# once). The Pi's space check file is read from FOUNDRY_AI_SPACE_STATUS (default
# /var/lib/foundry-ai-tool/space/status.json); leave it alone on the Pi.
DISCORD_OWNER_ID=

# Stale backup copy DMs (PB-06): the PC's pull scripts record each successful copy on the Pi
# (/var/lib/foundry-backup-pulls, root-owned, written by stage 6's record-pull.sh). The bot DMs the owner
# when a kind of copy (restic or snapshot) is older than this many days. Optional; default 3. Leave
# FOUNDRY_AI_BACKUP_PULLS (the folder) alone on the Pi.
FOUNDRY_AI_BACKUP_STALE_DAYS=3

# Where recordings go: one folder per session, raw/ while recording, Ogg tracks after /record stop.
# The PC copies finished sessions from here for transcription (tools/session-notes/pull.ps1).
FVTT_SESSIONS_DIR=/var/lib/foundry-ai-tool/recordings

# Channel posts (announce/announce.mjs): #changelog gets one Danish line per Pi deploy of a new release tag,
# #pr-log one silent line per merge (the PC's gate posts it). Both optional; without them nothing is posted.
DISCORD_CHANGELOG_CHANNEL_ID=
DISCORD_PRLOG_CHANNEL_ID=
# GM-only #dashboard-changelog (`announce.mjs dashboard`, release step 7) and the GM role it may mention
# (that post pings only this role). The PC's env file gets both; the Pi does not post it.
DISCORD_DASHBOARD_CHANGELOG_CHANNEL_ID=
DISCORD_GM_ROLE_ID=

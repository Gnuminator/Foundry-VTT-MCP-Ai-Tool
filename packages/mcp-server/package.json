{
  "name": "@gnuminator/mcp-server",
  "version": "0.27.0",
  "author": "Gnuminator <gnuminator@users.noreply.github.com>",
  "description": "MCP server for Foundry VTT integration with Claude Desktop",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "npm -w @gnuminator/shared run build && node ../../scripts/tsc7.mjs",
    "build:bundle": "node ../../scripts/tsc7.mjs && esbuild dist/index.js --bundle --platform=node --target=node24 --outfile=dist/index.bundle.cjs --format=cjs --define:import.meta.url='\"bundled\"' && esbuild dist/backend.js --bundle --platform=node --target=node24 --outfile=dist/backend.bundle.cjs --format=cjs --define:import.meta.url='\"bundled\"'",
    "dev": "node ../../node_modules/typescript/bin/tsc --watch",
    "start": "node dist/index.js",
    "vault": "node dist/vault-cli.js",
    "obsidian": "node dist/obsidian-cli.js",
    "start:standalone": "node dist/standalone.js",
    "start:bundle": "node dist/index.bundle.cjs",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "typecheck": "node ../../scripts/tsc7.mjs --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "dependencies": {
    "@gnuminator/shared": "*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^16.3.0",
    "htmlparser2": "^10.1.0",
    "winston": "^3.11.0",
    "ws": "^8.14.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.0",
    "@vitest/coverage-v8": "^3.2.6",
    "esbuild": "^0.19.0",
    "typescript": "~6.0.3",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "mcp",
    "foundry-vtt",
    "claude",
    "ai"
  ]
}

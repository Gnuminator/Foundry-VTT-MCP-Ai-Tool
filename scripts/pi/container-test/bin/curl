#!/usr/bin/env bash
# Stand-in for curl: /api/status answers what /tmp/status holds with the exit code in /tmp/status_rc (an @SYSVER@ in
# it becomes the installed dnd5e version), /join answers a running world's join page. A download (-o <file>) copies
# the zip named in /tmp/download_zip and logs its url to /tmp/downloads; without /tmp/download_zip it fails.
# Anything else fails.
# Switches (files, set by a scenario): /tmp/gm-counts makes /api/status count the Assistant GM browser as one user
# while that unit runs; /tmp/kit-counts does the same for the Kit GM browser (/tmp/started-kit); /tmp/joinfail makes
# /join fail once Foundry was stopped (the world does not come back); /tmp/join_fail makes /join answer an error
# page at once, as when no world runs.
url="${*: -1}"
out=""
prev=""
for a in "$@"; do
  [ "$prev" != -o ] || out="$a"
  prev="$a"
done
case "$url" in
  */api/status)
    if [ -f /tmp/gm-counts ] && [ ! -f /tmp/stopped-foundry-ai-tool-gm-browser.service ]; then
      echo '{"active":true,"users":1}'
      exit 0
    fi
    if [ -f /tmp/kit-counts ] && [ -f /tmp/started-kit ]; then
      echo '{"active":true,"users":1}'
      exit 0
    fi
    ver="$(sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' /var/lib/foundry/Data/systems/dnd5e/system.json 2>/dev/null | head -n1)"
    sed "s/@SYSVER@/${ver:-}/" /tmp/status
    exit "$(cat /tmp/status_rc)"
    ;;
  */join)
    if [ -f /tmp/joinfail ] && grep -q '^stop foundry.service' /tmp/calls 2>/dev/null; then
      exit 22
    fi
    if [ -f /tmp/join_fail ]; then
      echo '<html><body>No world is running</body></html>'
      exit 0
    fi
    echo '<template id="join-game">'
    exit 0
    ;;
esac
if [ -n "$out" ] && [ -f /tmp/download_zip ]; then
  echo "$url" >>/tmp/downloads
  cp "$(cat /tmp/download_zip)" "$out"
  exit 0
fi
echo "fake curl: unexpected url $url" >&2
exit 22

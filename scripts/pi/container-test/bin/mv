#!/usr/bin/env bash
# Stand-in for mv (stage 14 scenarios): everything goes to /bin/mv, except that when /tmp/mv_fail names a name and the
# source of a two-path move ends in it (for example dnd5e-6.0.5), the move fails once: nothing moves, /tmp/mv_fail is
# removed, and mv exits 1.
if [ -f /tmp/mv_fail ]; then
  want="$(cat /tmp/mv_fail)"
  paths=()
  for a in "$@"; do
    case "$a" in -*) ;; *) paths+=("$a") ;; esac
  done
  if [ "${#paths[@]}" = 2 ] && [ -n "$want" ]; then
    src="${paths[0]%/}"
    if [ "${src##*/}" = "$want" ]; then
      rm -f /tmp/mv_fail
      echo "mv: cannot move '$src': fake failure (/tmp/mv_fail)" >&2
      exit 1
    fi
  fi
fi
exec /bin/mv "$@"

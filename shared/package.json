{
  "name": "@gnuminator/shared",
  "version": "0.28.0",
  "author": "Gnuminator <gnuminator@users.noreply.github.com>",
  "description": "Shared TypeScript types and constants for Foundry AI Tool",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "catalog": "node ../scripts/usage-catalog.mjs --require-all",
    "build": "npm run catalog && node ../scripts/tsc7.mjs",
    "dev": "node ../node_modules/typescript/bin/tsc --watch",
    "typecheck": "npm run catalog && node ../scripts/tsc7.mjs --noEmit",
    "test": "npm run catalog && vitest run"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "zod": "^3.22.0"
  },
  "files": [
    "dist"
  ]
}

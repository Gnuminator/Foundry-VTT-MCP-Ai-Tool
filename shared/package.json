{
  "name": "@gnuminator/shared",
  "version": "0.31.0",
  "author": "Gnuminator <gnuminator@users.noreply.github.com>",
  "description": "Shared TypeScript types and constants for Foundry AI Tool",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "development": "./src/browser.ts",
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "catalog": "node ../scripts/usage-catalog.mjs --require-all && node ../scripts/skill-guides.mjs",
    "build": "npm run catalog && node ../scripts/tsc7.mjs",
    "dev": "node ../node_modules/typescript/bin/tsc --watch",
    "typecheck": "npm run catalog && node ../scripts/tsc7.mjs --noEmit",
    "test": "npm run catalog && vitest run"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "acorn": "8.19.0",
    "zod": "^4.6.7"
  },
  "files": [
    "dist"
  ]
}

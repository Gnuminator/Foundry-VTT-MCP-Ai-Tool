# Copy to .env (or run scripts/livekit-poc.ps1 init, which generates one with random keys).
# .env is gitignored. Never commit real keys.

# API key and secret for the LiveKit server, the recorder, egress and the Foundry module.
# LiveKit wants a secret of at least 32 characters.
LIVEKIT_API_KEY=devkeyREPLACEME
LIVEKIT_API_SECRET=REPLACEME_with_at_least_32_random_characters

# Address browsers on this PC use to reach the media port (127.0.0.1 for a single-PC test).
# For a test with other people on your LAN, set this to the PC's LAN address.
LIVEKIT_NODE_IP=127.0.0.1

# Host ports (only change them if they clash with something else).
LIVEKIT_SIGNAL_PORT=7880
LIVEKIT_TCP_PORT=7881
LIVEKIT_UDP_PORT=7882
LIVEKIT_TLS_PORT=7443

# Recorder. Audio is always recorded; camera video and screen share are opt-in.
RECORD_AUDIO=true
RECORD_VIDEO=false
RECORD_SCREEN_SHARE=false
# Time zone for the session folder name yyyy-mm-dd_HHMM.
RECORDER_TIMEZONE=Europe/Copenhagen
# Optional: JSON file mapping participant identity or name to a label. Put it in ./recorder-config/
# and give the path as seen inside the container, e.g. /config/labels.json (see labels.example.json).
# Example: {"<foundry user id>": "Player 1"}
RECORDER_LABELS_FILE=

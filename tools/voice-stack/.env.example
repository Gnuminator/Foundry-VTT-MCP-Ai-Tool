# Copy to .env (or run: pwsh scripts/voice-stack.ps1 init, which also makes random LiveKit keys).
# .env is gitignored. Never commit real keys or tokens.

# Host folder for session audio (inputs) and transcripts (outputs), outside the repo.
# One subfolder per session. Default if unset: %USERPROFILE%/Documents/FoundrySessions
FVTT_SESSIONS_DIR=C:/Users/you/Documents/FoundrySessions

# Optional: host file with a Hugging Face token, mounted read-only into the transcriber. Only
# needed for gated models (saga-2-m). Leave unset for public models.
# HF_TOKEN_FILE=C:/Users/you/.cache/huggingface/token

# Transcriber image: 0 = faster-whisper only, 1 = also torch and transformers (hviske-v6, saga-2-m).
# With 1, also set TRANSCRIBER_TAG=extras so the two images stay apart.
TRANSCRIBER_EXTRAS=0
TRANSCRIBER_TAG=latest

# ---- LiveKit (profile livekit); the same settings as tools/livekit/.env.example ----
LIVEKIT_API_KEY=devkeyREPLACEME
LIVEKIT_API_SECRET=REPLACEME_with_at_least_32_random_characters
# Address browsers use to reach the media port (127.0.0.1 for a single-PC test).
LIVEKIT_NODE_IP=127.0.0.1
# LIVEKIT_SIGNAL_PORT=7880
# LIVEKIT_TCP_PORT=7881
# LIVEKIT_UDP_PORT=7882
# LIVEKIT_TLS_PORT=7443
RECORD_AUDIO=true
RECORD_VIDEO=false
RECORD_SCREEN_SHARE=false
RECORDER_TIMEZONE=Europe/Copenhagen
